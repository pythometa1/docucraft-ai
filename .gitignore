# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Backend (FastAPI)
backend/.venv
# The dev SQLite database and every backup of it. `backend/documind.db` was the
# only spelling here, and the file the app actually opens is `documind_ui.db` --
# so an 8 MB database holding real uploaded documents was one `git add -A` away
# from the history. The glob covers the timestamped backups a migration leaves.
backend/documind.db
backend/documind_ui.db
backend/*.db
backend/*.db-shm
backend/*.db-wal
backend/*.db.backup-*
backend/storage/
backend/__pycache__/
backend/**/__pycache__/
backend/.env

# Any .env, anywhere -- these hold API keys. backend/.env was already
# covered; the root one (VITE_API_URL today) was not.
.env
.env.*
!.env.example

# Scratch space for probing a running instance -- logs, dumped parts, one-off
# scripts. Nothing here is an input to anything.
.tmp_probe/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Coverage artefacts. Regenerated by scripts/check.sh on every run; committing
# them makes every test run show up as a diff.
backend/.coverage
backend/coverage.xml

# Client-owned template masters and everything derived from them. The repository
# is public and these documents are the customer's, not ours -- a Hospira/Pfizer
# offer letter and two ICC contract masters, plus the golden outputs and
# snapshots generated from them.
#
# They stay on the machines that have them, where the full suite runs unchanged.
# tests/conftest.py skips the modules that read them when they are absent, so a
# clone reports skips rather than failures.
backend/tests/fixtures/templates/hospira_offer.docx
backend/tests/fixtures/templates/icc_ct*.docx
backend/tests/fixtures/goldens/hospira_*/
backend/tests/fixtures/records/icc_ct*.xlsx
backend/tests/fixtures/canaries/icc_ct*.json
backend/tests/fixtures/snapshots/*hospira*.json
