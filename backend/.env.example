# DocuMind configuration.
#
# Copy to .env for local development. In production these come from the
# platform's secret store, never from a file in the image.
#
# ENV=production makes the process REFUSE to start if any of the first four are
# still development values -- see app/config.py. That is deliberate: each of
# them fails silently rather than loudly, and a warning in a log nobody reads is
# not a control.

ENV=development

# --- the four the production guard checks -------------------------------
# Must be PostgreSQL in production: row-level security, the pgvector column and
# the concurrency this service assumes are all things SQLite cannot do.
# Connect as the APPLICATION role (NOSUPERUSER NOBYPASSRLS), never the owner --
# a superuser reads through every RLS policy while everything still looks right.
DATABASE_URL=postgresql+psycopg://documind_app:CHANGE_ME@localhost:5432/documind

# openssl rand -hex 32
JWT_SECRET=CHANGE_ME_32_CHARS_MINIMUM

# JSON list. No wildcard in production: any page a signed-in user visits could
# otherwise call this API with their session.
CORS_ORIGINS=["https://app.example.com"]

REDIS_URL=redis://localhost:6379/0

# --- storage ------------------------------------------------------------
# Uploaded templates, source files and generated documents. Must be durable and
# backed up; a container filesystem is neither.
STORAGE_DIR=/var/lib/documind

# --- language models ----------------------------------------------------
# Only onboarding needs one. The deterministic generation path makes no model
# call at all, so a missing key blocks compiling new templates and nothing else.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_COMPILE_MODEL=claude-opus-5
LLM_MODEL=claude-sonnet-5

# GLOBAL | EU | UK | IN. What the configured deployment can actually offer.
# An organisation requiring more than this gets a refusal, not a prompt.
LLM_RESIDENCY=GLOBAL
# Confirm contractually before setting true; the app takes this as a promise.
LLM_ZERO_RETENTION=false

# --- limits -------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_BURST=60
