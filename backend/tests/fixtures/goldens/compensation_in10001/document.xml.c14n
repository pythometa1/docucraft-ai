          <w:rFonts w:ascii="Calibri" w:cs="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri"/>
          <w:color w:val="000000"/>
          <w:sz w:val="22"/>
          <w:szCs w:val="22"/>
        </w:rPr>
        <w:t xml:space="preserve"> months from your date of joining. Confirmation in writing follows satisfactory completion; the Company may extend probation at its discretion. During probation either party may terminate this engagement on seven (7) days' written notice.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:spacing w:after="140"/>
      </w:pPr>
