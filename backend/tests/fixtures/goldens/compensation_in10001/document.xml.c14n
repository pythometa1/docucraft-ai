          <w:szCs w:val="22"/>
        </w:rPr>
        <w:t xml:space="preserve">Salary is credited on or before the last working day of each calendar month, subject to deduction of income tax at source, provident fund contributions, professional tax and any other statutory deductions applicable at your work location.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
