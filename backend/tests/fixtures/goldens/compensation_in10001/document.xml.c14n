          <w:szCs w:val="22"/>
        </w:rPr>
        <w:t xml:space="preserve">This offer is contingent on satisfactory completion of background verification, receipt of your relieving letter from your previous employer, verification of educational and employment records, and your being medically fit for the role. The Company may withdraw this offer at any stage if any information furnished by you is found to be incorrect or incomplete.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:spacing w:after="140"/>
      </w:pPr>
      <w:r>
        <w:rPr>
