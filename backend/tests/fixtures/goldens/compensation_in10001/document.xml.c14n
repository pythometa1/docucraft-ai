          <w:color w:val="000000"/>
          <w:sz w:val="22"/>
          <w:szCs w:val="22"/>
        </w:rPr>
        <w:t xml:space="preserve">Your compensation is personal and confidential. Disclosing it to any colleague or third party, other than as required by law, is treated as a breach of the Company's Code of Conduct. Your employment is further governed by the Company's policies as published on the intranet and amended from time to time.</w:t>
      </w:r>
    </w:p>
